# Copy to .env.local. Leave NEXT_PUBLIC_SEHAT_ESCROW empty to run on sample data (preview mode).
# Bohr testnet deployment: 0xbC555De32fb45a8FF3297cbbc1a6F50F7674Bb54 (see contracts/deployments/bohr-testnet.json).
NEXT_PUBLIC_SEHAT_NETWORK=testnet
NEXT_PUBLIC_SEHAT_ESCROW=
NEXT_PUBLIC_SEHAT_ESCROW_BLOCK=
# Set to "live" to use the private reports service (needs the escrow address).
NEXT_PUBLIC_SEHAT_REPORTS=
# 32+ random characters; required in production.
SEHAT_SESSION_SECRET=
# Comma-separated lowercase admin wallets (moderation only).
SEHAT_ADMINS=
